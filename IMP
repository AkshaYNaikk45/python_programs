PHP Script (vowel.php)

<?php
function countVowels($str)
{
 $str = strtolower($str);
 $vowels = array('a'=>0,'e'=>0,'i'=>0,'o'=>0,'u'=>0);
 for($i=0; $i<strlen($str); $i++)
 {
 $ch = $str[$i];
 if(array_key_exists($ch,$vowels))
 {
 $vowels[$ch]++;
 }
 }
 return $vowels;
}
$text = $_POST['text'];
$result = countVowels($text);
$total = array_sum($result);
echo "<h2>Result</h2>";
echo "Total Vowels = ".$total."<br><br>";
echo "Occurrences of Each Vowel:<br>";
foreach($result as $vowel=>$count)
{
 echo $vowel." = ".$count."<br>";
}
?>

