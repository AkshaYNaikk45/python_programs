                table += "<tr>";
                for (var j = 0; j < row.length; j++)
                {
                    table += "<td>" + row[j] + "</td>";
                }
                table += "</tr>";
            }

            table += "</table>";
            document.getElementById("table").innerHTML = table;
        }
    };

    xhttp.open("GET", "contact.dat", true);
    xhttp.send();
