    id INT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(100),
    gender VARCHAR(10),
    dob DATE
);

Code:-


import java.sql.*;
public class PersonSearch {
    public static void main(String[] args) {
        String url = "jdbc:mysql://localhost:3306/your_database";
        String user = "root";
        String password = "your_password";

        try {
            // 1. Load Driver
            Class.forName("com.mysql.cj.jdbc.Driver");
            // 2. Establish Connection
            Connection con = DriverManager.getConnection(url, user, password);
            // -------------------------------
            // Query 1: Persons born in 1986
            // -------------------------------
            String query1 = "SELECT * FROM Person WHERE YEAR(dob) = ?";
            PreparedStatement ps1 = con.prepareStatement(query1);
            ps1.setInt(1, 1986);
            ResultSet rs1 = ps1.executeQuery();
            System.out.println("Persons born in 1986:");
            while (rs1.next()) {
                System.out.println(
                        rs1.getInt("id") + " | " +
                        rs1.getString("name") + " | " +
                        rs1.getString("gender") + " | " +
                        rs1.getDate("dob")
                );
            }
            // ---------------------------------------------
            // Query 2: Females born between 2000 and 2005
            // ---------------------------------------------
            String query2 = "SELECT * FROM Person WHERE gender = ? AND dob BETWEEN ? AND ?";
            PreparedStatement ps2 = con.prepareStatement(query2);
            ps2.setString(1, "Female");
            ps2.setDate(2, Date.valueOf("2000-01-01"));
            ps2.setDate(3, Date.valueOf("2005-12-31"));
            ResultSet rs2 = ps2.executeQuery();
            System.out.println("\nFemales born between 2000 and 2005:");
            while (rs2.next()) {
                System.out.println(
                        rs2.getInt("id") + " | " +
                        rs2.getString("name") + " | " +
                        rs2.getString("gender") + " | " +
                        rs2.getDate("dob")
                );
            }
            // Close connections
            rs1.close();
            rs2.close();
            ps1.close();
            ps2.close();
            con.close();
        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
