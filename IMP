class Temperature
{
 public $celsius;
 public $fahrenheit;
 // Parameterized constructor
 function __construct($c,$f)
 {
 $this->celsius = $c;
 $this->fahrenheit = $f;
 }
 // Celsius to Fahrenheit
 function c_to_f()
 {
 return ($this->celsius * 9/5) + 32;
 }
 // Fahrenheit to Celsius
 function f_to_c()
 {
 return ($this->fahrenheit - 32) * 5/9;
 }
}
$c = $_POST['celsius'];
