PHP File (student.php)

<?php
$students = array(
"Amol","Amit","Anita","Ajay","Bhushan","Bhakti",
"Chaitali","Chetan","Dipali","Dinesh","Kiran",
"Komal","Mahesh","Neha","Pooja","Rahul","Rohit",
"Sonali","Suresh","Vaishali"
);
$q = $_GET["q"];
$hint = "";
if ($q !== "")
{
 $q = strtolower($q);
 $len = strlen($q);
 foreach($students as $name)
 {
 if (stristr($q, substr($name,0,$len)))
 {
 if ($hint === "")
 {
 $hint = $name;
 }
 else
 {
 $hint .= "<br>$name";
 }
 }
 }
}
echo ($hint === "") ? "No Suggestion" : $hint;
?>


