function printTable()
{
    var n = document.getElementById("num").value;
    var result = "";

    for(let i = 1; i <= n; i++)
    {
        result += "Table of " + i + "\n";
        for(let j = 1; j <= 10; j++)
        {
            result += i + " x " + j + " = " + (i*j) + "\n";
