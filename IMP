vector1 <- c(10, 20, 10, 30, 40, 50, 20)
vector2 <- c("A", "B", "A", "C", "D", "E", "B")
# Create a data frame from the vectors
# The vector names become the column names in the data frame
df <- data.frame(Col1 = vector1, Col2 = vector2)
# Display the original data frame
print("Original Data Frame:")
print(df)
# Display the duplicated elements/rows
# duplicated() returns a logical vector; TRUE indicates a row is a duplicate of a previous row
# We use this logical vector to subset the data frame
duplicated_rows <- df[duplicated(df), ]
print("Duplicated Rows:")
