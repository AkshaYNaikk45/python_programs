<!DOCTYPE html>
<html>
<head>
<title>Swap Two Values</title>
</head>
<body>
<h2>Swapping of Two Values</h2>
<script>
var A = 100;
var B = 200;
document.write("Before Swapping:<br>");
document.write("A = " + A + "<br>");
document.write("B = " + B + "<br><br>");
var temp;
temp = A;
A = B;
B = temp;
document.write("After Swapping:<br>");
document.write("A = " + A + "<br>");
document.write("B = " + B);
</script>
</body>
</html>


