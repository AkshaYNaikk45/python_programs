print("Unique Rows:")
print(unique_rows)


Assignment 14: Write a R program to save the information of a data frame in a file and display the
information of the file.
Solution:
# 1. Create a sample data frame
df <- data.frame(
 Name = c("Alice", "Bob", "Charlie"),
 Age = c(25, 30, 28),
 Salary = c(50000, 65000, 55000)
)
# Display the original data frame in the console
print("Original data frame:")
print(df)
cat("\n") # Add a newline for better formatting
# 2. Save the data frame to a file
# The write.csv() function saves the data frame to a CSV file.
# Setting row.names = FALSE prevents R from adding an extra column of row numbers.
file_name <- "employees.csv"
write.csv(df, file = file_name, row.names = FALSE)
cat("Data frame successfully saved to '", file_name, "'\n\n", sep="")
# 3. Display the information of the saved file
# The file.info() function retrieves information (like size, type, permissions, etc.) about the file.
file_details <- file.info(file_name)
print("Information about the file:")
print(file_details)
cat("\n")
# (Optional) Read the file back into a new data frame to verify content
# The read.csv() function is used to load data from a CSV file back into a data frame.
imported_data <- read.csv(file_name)
print("Data frame after reading the file back into R:")
print(imported_data)


